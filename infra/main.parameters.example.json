{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": {
      "value": "aiaccelerator"
    },
    "environmentName": {
      "value": "dev"
    },
    "location": {
      "value": "eastus2"
    },
    "networkMode": {
      "value": "public"
    },
    "allowPublicAccess": {
      "value": true
    },
    "monitoringMode": {
      "value": "none"
    },
    "privateNetwork": {
      "value": {
        "privateEndpointSubnetId": "",
        "webIntegrationSubnetId": "",
        "logicIntegrationSubnetId": "",
        "privateDnsZoneIds": {}
      }
    },
    "existingMonitoring": {
      "value": {
        "applicationInsightsConnectionString": "",
        "logAnalyticsWorkspaceId": "",
        "azureMonitorPrivateLinkScopeId": ""
      }
    },
    "aiResources": {
      "value": {
        "foundry": {
          "mode": "new"
        },
        "documentIntelligence": {
          "mode": "new"
        },
        "search": {
          "mode": "new"
        }
      }
    },
    "skus": {
      "value": {
        "webAppPlan": {
          "name": "B1"
        },
        "logicAppPlan": {
          "name": "WS1"
        },
        "containerRegistry": "Basic",
        "search": {
          "name": "basic"
        },
        "documentIntelligence": "S0",
        "cosmos": {
          "mode": "serverless"
        },
        "storage": "Standard_LRS"
      }
    },
    "modelDeployments": {
      "value": [
        {
          "name": "chat",
          "model": "gpt-4.1-mini",
          "version": "2025-04-14",
          "skuName": "GlobalStandard",
          "capacity": 10
        }
      ]
    },
    "chatDeploymentName": {
      "value": "chat"
    },
    "identity": {
      "value": {
        "principalId": "",
        "principalType": "User",
        "enableAppServiceAuth": true,
        "appServiceAuthClientId": "<app-registration-client-id>"
      }
    },
    "hosting": {
      "value": {
        "corsAllowedOrigins": [],
        "allowedIpRanges": [
          "<your-public-ip>/32"
        ]
      }
    },
    "tags": {
      "value": {
        "CostCenter": "replace-me",
        "TechnicalOwner": "replace-me"
      }
    }
  }
}
